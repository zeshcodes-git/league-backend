# Copy this file to ".env" and fill in your own values.
# Never share your .env file or paste its contents anywhere public.

# Find this in your league's URL:
# https://fantasyfootball.espn.com/football/league?leagueId=XXXXXXXX
ESPN_LEAGUE_ID=

# The season year your league is in, e.g. 2026
ESPN_SEASON=2026

# --- Private leagues only ---
# Leave these blank if your league is public.
# See README.md for how to get these two values from your browser.
ESPN_S2=
ESPN_SWID=

# Port the local server runs on (fine to leave as-is)
PORT=3001
